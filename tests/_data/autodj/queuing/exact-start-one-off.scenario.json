  "modes": [
    "in_memory",
    "integration"
  ],
  "cases": [
    {
      "name": "one-off-exact-start-falls-back-to-interrupt",
      "now": "2018-01-15T12:05:00+00:00",
      "expect_sequence": [
        {
          "mode": "exact",
          "interrupting": false,
          "playlist_ref": "regular",
          "media_ref": "mNorm",
          "playlist_chain_refs": []
        },
        {
          "mode": "exact",
          "interrupting": true,
          "playlist_ref": "exact",
          "media_ref": "mExact",
          "playlist_chain_refs": []
        }
      ]
    }
  ]
}
